# Copy this file to ".env" and fill in real values.
# ".env" is git-ignored — it must NEVER be committed.
# This file only documents which variables exist; no real secrets belong here.

# ---- MySQL ----
# Root password is only used once, by MySQL itself, to bootstrap the app user below.
DB_ROOT_PASSWORD=change_me_root_password
# Least-privilege application user (NOT root) that the services connect as.
DB_USERNAME=renthub_app
DB_PASSWORD=change_me_app_password
DB_HOST=mysql
DB_PORT=3306

# ---- JWT signing secret ----
# Generate your own with: openssl rand -base64 32
JWT_SECRET=change_me_generate_a_real_secret

# ---- Service discovery / config server hostnames (docker network service names) ----
EUREKA_HOST=eureka-server
EUREKA_PORT=8761
CONFIG_SERVER_HOST=config-server
CONFIG_SERVER_PORT=8888

# ---- CORS ----
CORS_ALLOWED_ORIGIN=http://localhost:3000

# ---- Splunk ----
# Admin console password for the Splunk web UI (http://localhost:8000, user "admin").
# Must be at least 8 characters.
SPLUNK_PASSWORD=change_me_splunk_admin_password
# HTTP Event Collector token (any GUID). Shared by the splunk container (which
# accepts it) and every app service (which sends events/metrics with it).
# Generate your own with: [guid]::NewGuid() (PowerShell) or uuidgen (bash)
SPLUNK_HEC_TOKEN=change_me_generate_a_real_guid
# Internal docker-network URL app services POST HEC events/metrics to.
SPLUNK_HEC_URL=http://splunk:8088
